{
  "name": "print-pdf-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run server/app.test.js server/print-layout.test.js tests/render-queue.test.js tests/pdf-smoke.test.js",
    "test:unit": "vitest run server/app.test.js",
    "test:layout": "vitest run server/print-layout.test.js",
    "test:pdf": "vitest run tests/pdf-smoke.test.js",
    "test:perf": "vitest run tests/pdf-performance.test.js",
    "smoke": "pnpm build && pnpm test:pdf",
    "test:queue": "vitest run tests/render-queue.test.js"
  },
  "dependencies": {
    "@vue/server-renderer": "^3.5.34",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "playwright": "^1.60.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  }
}
