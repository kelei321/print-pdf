{
  "name": "print-pdf-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run server/app.test.js server/print-layout.test.js tests/render-queue.test.js tests/pdf-smoke.test.js",
    "test:unit": "vitest run server/app.test.js",
    "test:layout": "vitest run server/print-layout.test.js",
    "test:pdf": "vitest run tests/pdf-smoke.test.js",
    "test:perf": "vitest run tests/pdf-performance.test.js",
    "smoke": "npm run build && npm run test:pdf",
    "test:queue": "vitest run tests/render-queue.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "^3.5.13",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.7"
  }
}
