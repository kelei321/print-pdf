PORT=3000
PDF_MAX_HTML_BYTES=20971520
PDF_RENDER_TIMEOUT_MS=120000
PDF_PRINT_READY_TIMEOUT_MS=120000
PDF_MAX_CONCURRENT=3
PDF_MAX_QUEUE=20
PDF_QUEUE_TIMEOUT_MS=30000

# Browser selection priority:
# 1. PDF_BROWSER_EXECUTABLE_PATH
# 2. PDF_BROWSER_CHANNEL
# 3. Playwright Chromium
# 4. common system Chromium/Chrome executables
# 5. Chrome/Edge channels
PDF_BROWSER_EXECUTABLE_PATH=
PDF_BROWSER_CHANNEL=
PDF_BROWSER_SANDBOX=false

# Security: external HTTP(S) resources are blocked by default.
PDF_ALLOW_EXTERNAL_RESOURCES=false
PDF_ALLOWED_RESOURCE_ORIGINS=

# Optional performance test expansion, for example: 5000,10000
PDF_PERF_ROWS=
